{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "web/src/design-system/components/cards/**",
              "web/src/design-system/components/core/**",
              "web/src/design-system/components/data/**",
              "web/src/design-system/components/forms/**",
              "web/src/design-system/components/navigation/**",
              "web/src/design-system/components/overlay/**",
              "prototypes/dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|pointLabels|tooltipLabels|ticks|yMax|yTicks|yFormat|series|valueFormat|height|persistent|defaultIndex|style|key|ref|className|style|children)$/]",
        "message": "<AreaChart> doesn't accept that prop. Declared props: data, pointLabels, tooltipLabels, ticks, yMax, yTicks, yFormat, series, valueFormat, height, persistent, defaultIndex, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|positive|negative)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'positive' | 'negative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|color|style|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: height, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|block|pill|disabled|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, block, pill, disabled, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:secondary|filled|ghost|inverse)$/]",
        "message": "<Button> variant must be one of 'secondary' | 'filled' | 'ghost' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<ButtonGroup> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlockLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|time|tone|key|ref|className|style|children)$/]",
        "message": "<CodeBlockLine> doesn't accept that prop. Declared props: text, time, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlockLine'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|muted|ok|error|cmd)$/]",
        "message": "<CodeBlockLine> tone must be one of 'info' | 'muted' | 'ok' | 'error' | 'cmd'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|width|align|render|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, width, align, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Delta'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|direction|suffix|style|key|ref|className|style|children)$/]",
        "message": "<Delta> doesn't accept that prop. Declared props: value, direction, suffix, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Delta'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<Delta> direction must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<GroupButton> doesn't accept that prop. Declared props: icon, children, onClick, style."
