        "message": "<IconButton> doesn't accept that prop. Declared props: icon, size, variant, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:secondary|ghost)$/]",
        "message": "<IconButton> variant must be one of 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsightText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|highlight|after|style|key|ref|className|style|children)$/]",
        "message": "<InsightText> doesn't accept that prop. Declared props: children, highlight, after, style."
      },
