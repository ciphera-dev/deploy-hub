# Ciphera — variables d'environnement (noms seulement, jamais de valeurs réelles ici).
# Copier en .env pour le développement local ; en production, fichier /etc/ciphera/ciphera.env (droits 600).

# Plan de contrôle
CIPHERA_LISTEN_ADDR=
# Origine publique du panneau (https://hote[:port] ; http seulement pour localhost) :
# préfixe des liens d'invitation et de réinitialisation ; sans elle, aucun e-mail n'en envoie.
CIPHERA_PUBLIC_URL=
# Autres noms DNS du panneau, séparés par des virgules (ex. admin.exemple.com). L'accès direct
# (port 8443) ne sert que les adresses IP, localhost et les noms réservés au panneau (hôte de
# CIPHERA_PUBLIC_URL, CIPHERA_WEBAUTHN_RP_ID, ces alias, domaine du panneau confirmé) : tout autre
# nom reçoit 421. Un nom réservé ne peut pas devenir le domaine d'un projet. Nom internationalisé :
# forme ASCII (punycode xn--...).
CIPHERA_PANEL_ALIASES=
DATABASE_URL=
CIPHERA_DB_MAX_CONNECTIONS=

# Secrets (chiffrement enveloppe age) : chemin vers l'identité, jamais la clé elle-même
CIPHERA_AGE_IDENTITY_FILE=

# PKI des agents (mTLS)
CIPHERA_PKI_DIR=
CIPHERA_AGENT_QUIC_ADDR=

# Sessions / WebAuthn
CIPHERA_SESSION_SECRET_FILE=
# RP ID des passkeys : par défaut le nom de domaine de l'origine publique (domaine du panneau confirmé,
# sinon CIPHERA_PUBLIC_URL), à défaut l'hôte de la requête. Les passkeys ne servent alors qu'à cette adresse et à
# ses sous-domaines (pas par l'IP, localhost ni un alias). Changer de domaine rend les passkeys inutilisables.
CIPHERA_WEBAUTHN_RP_ID=
CIPHERA_WEBAUTHN_RP_ORIGIN=

# Jeton de setup à usage unique (émis par install.sh, désactivé après le premier admin)
CIPHERA_SETUP_TOKEN_FILE=

# Proxy (Pingora + ACME)
CIPHERA_ACME_DIRECTORY_URL=
CIPHERA_ACME_CONTACT_EMAIL=

# Observabilité
OTEL_EXPORTER_OTLP_ENDPOINT=
CIPHERA_METRICS_ADDR=
RUST_LOG=

# Agent de nœud
CIPHERA_CONTROL_PLANE_URL=
CIPHERA_JOIN_TOKEN=
CIPHERA_AGENT_STATE_DIR=
CIPHERA_BUILDKIT_ADDR=
# Sortie réseau des applications (table nftables inet ciphera_egress) : 1 interdit aussi
# les plages privées (10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7) ; 0 (défaut) les permet.
# En production : fichier root /etc/ciphera-egress/egress.env (0644), lu par `ciphera-agent egress`,
# ou variable passée à install.sh. Appliqué en 5 min au plus (ciphera-egress-check.timer).
CIPHERA_APP_EGRESS_DENY_PRIVATE=
