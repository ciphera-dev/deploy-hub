{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/memory_hook.py\" --agent codex",
            "commandWindows": "python .agents/hooks/memory_hook.py --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash|shell|exec_command|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/memory_hook.py\" --agent codex",
            "commandWindows": "python .agents/hooks/memory_hook.py --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/memory_hook.py\" --agent codex",
            "commandWindows": "python .agents/hooks/memory_hook.py --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/memory_hook.py\" --agent codex",
            "commandWindows": "python .agents/hooks/memory_hook.py --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/memory_hook.py\" --agent codex",
            "commandWindows": "python .agents/hooks/memory_hook.py --agent codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
