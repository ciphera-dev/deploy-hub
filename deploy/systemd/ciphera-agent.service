# Agent local Ciphera : pilote Docker (PostgreSQL et BuildKit epingles par
# digest, un buildkitd par projet demarre a la demande, conteneurs des
# applications) et le proxy du noeud.
# Le groupe docker equivaut a root : voir le modele de menaces.
# Sans Docker, l'unite n'est pas lancee (condition non remplie, sans erreur).
# Dossiers des sockets (/run/ciphera/postgres, /run/ciphera-agent/buildkit) :
# ciphera.tmpfiles.conf.
[Unit]
Description=Ciphera - agent local
After=network-online.target docker.service systemd-tmpfiles-setup.service
Wants=network-online.target docker.service
ConditionPathExists=/var/run/docker.sock

[Service]
Type=simple
User=ciphera-agent
Group=ciphera-agent
# Filtrage de la sortie des conteneurs (avant l'agent, en root : prefixe +),
# table nftables a part (inet ciphera_egress) generee par le binaire lui-meme
# (module egress) et remplacee en une transaction :
# - builds (ponts ciphera-build et ciphera-prepare) : ni l'hote (plan de
#   controle, agent, API Docker, PostgreSQL, proxy : chaine input), ni les
#   metadonnees des clouds, ni les plages privees, locales, CGNAT, de lien
#   local, multicast, NAT64, 6to4 ou Teredo (chaine forward) ;
# - applications (ponts de projet cphp<10 hex>) : ni l'hote (sauf le trafic
#   etabli et les ports 80/443 du proxy), ni les metadonnees des clouds
#   (169.254.0.0/16, fd00:ec2::254, 100.100.100.200, 168.63.129.16) ;
#   plages privees permises, sauf CIPHERA_APP_EGRESS_DENY_PRIVATE=1 dans
#   /etc/ciphera-egress/egress.env (fichier root).
# Seule exception commune : le DNS (port 53) vers les resolveurs de l'hote,
# lus au chargement (/etc/resolv.conf, ou /run/systemd/resolve/resolv.conf).
# Un rejet y est definitif quel que soit le pare-feu de Docker. Sans nft,
# l'agent ne demarre pas (aucun conteneur sans filtre) : install.sh installe
# nftables. ciphera-egress-check.timer recharge la table toutes les 5 min.
ExecStartPre=+/usr/local/bin/ciphera-agent egress load
ExecStart=/usr/local/bin/ciphera-agent
Restart=on-failure
RestartSec=5s

StateDirectory=ciphera-agent
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
# Certificat de l'agent renouvele sur le lien (agent.crt).
ReadWritePaths=-/etc/ciphera-agent
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
# /dev prive (null, zero, urandom, tty...) : ni l'agent, ni docker, ni git
# n'ouvrent de peripherique ; l'API Docker est un socket de /run.
PrivateDevices=yes
# Sockets : Unix (API Docker, sockets de buildkitd et du proxy), IPv4/IPv6
# (lien QUIC, git, registres), netlink (lecture des interfaces par les
# outils Go : docker, docker compose, buildctl).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Appels systeme d'un service ordinaire (Rust, Go, git) : ni montage, ni
# module, ni ptrace, ni horloge, ni reboot. Un appel hors liste echoue
# (EPERM) au lieu de tuer le processus : un outil tiers qui sonde un appel
# facultatif se replie au lieu de planter.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
