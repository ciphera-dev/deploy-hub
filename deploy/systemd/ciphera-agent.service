# Agent local Ciphera : pilote Docker (PostgreSQL et BuildKit epingles par
# digest, conteneurs des applications) et le proxy du noeud.
# Le groupe docker equivaut a root : voir le modele de menaces.
# Sans Docker, l'unite n'est pas lancee (condition non remplie, sans erreur).
# Dossiers des sockets (/run/ciphera/postgres, /run/ciphera-agent/buildkit) :
# ciphera.tmpfiles.conf.
[Unit]
Description=Ciphera - agent local
After=network-online.target docker.service systemd-tmpfiles-setup.service
Wants=network-online.target docker.service
ConditionPathExists=/var/run/docker.sock

[Service]
Type=simple
User=ciphera-agent
Group=ciphera-agent
# Filtrage de la sortie des builds (avant l'agent, en root : prefixe +) :
# les ponts ciphera-build (buildkitd et ses etapes RUN) et ciphera-prepare
# (railpack prepare) n'atteignent ni l'hote lui-meme (plan de controle,
# agent, API Docker, PostgreSQL, proxy : chaine input), ni les adresses de
# metadonnees des clouds (169.254.169.254, fd00:ec2::254, 100.100.100.200,
# 168.63.129.16), ni les plages privees, locales, CGNAT, de lien local ou
# multicast (chaine forward) ; Internet public reste ouvert (paquets, depots
# git, images). Seule exception : le DNS (port 53, TCP et UDP), car le
# resolveur des clouds est souvent prive ou de lien local (168.63.129.16,
# 169.254.169.253, 169.254.169.254 chez GCP, x.x.x.2 d'un VPC) ; il n'ouvre
# que ce port, pas le reste de ces adresses. Table nftables a part
# (inet ciphera_egress) : un rejet y est definitif quel que soit le pare-feu
# de Docker (iptables ou nftables).
# Remplacement atomique (une seule transaction nft). Sans nft, l'agent ne
# demarre pas (aucun build sans filtre) : install.sh installe nftables.
ExecStartPre=+/usr/sbin/nft "\
add table inet ciphera_egress; \
delete table inet ciphera_egress; \
table inet ciphera_egress { \
  set blocked4 { type ipv4_addr; flags interval; elements = { \
    0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 168.63.129.16, \
    169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, \
    198.18.0.0/15, 224.0.0.0/3 }; }; \
  set blocked6 { type ipv6_addr; flags interval; elements = { \
    ::/127, ::ffff:0:0/96, 64:ff9b:1::/48, fc00::/7, fe80::/10, ff00::/8 }; }; \
  chain input { type filter hook input priority -10; policy accept; \
    iifname { \"ciphera-build\", \"ciphera-prepare\" } \
      meta l4proto { tcp, udp } th dport 53 accept; \
    iifname { \"ciphera-build\", \"ciphera-prepare\" } icmpv6 type \
      { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit } accept; \
    iifname { \"ciphera-build\", \"ciphera-prepare\" } \
      reject with icmpx admin-prohibited; }; \
  chain forward { type filter hook forward priority -10; policy accept; \
    iifname { \"ciphera-build\", \"ciphera-prepare\" } \
      meta l4proto { tcp, udp } th dport 53 accept; \
    iifname { \"ciphera-build\", \"ciphera-prepare\" } ip daddr @blocked4 \
      reject with icmpx admin-prohibited; \
    iifname { \"ciphera-build\", \"ciphera-prepare\" } ip6 daddr @blocked6 \
      reject with icmpx admin-prohibited; }; \
}"
ExecStart=/usr/local/bin/ciphera-agent
Restart=on-failure
RestartSec=5s

StateDirectory=ciphera-agent
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
# Certificat de l'agent renouvele sur le lien (agent.crt).
ReadWritePaths=-/etc/ciphera-agent
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
