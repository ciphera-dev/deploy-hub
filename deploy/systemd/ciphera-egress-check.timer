# Controle du filtrage de la sortie des conteneurs toutes les 5 minutes
# (ciphera-egress-check.service) : une table disparue est retablie en moins
# de 5 minutes. Calendrier fixe (et non OnUnitActiveSec) : le rythme ne
# depend pas des executions sautees du service (hote sans Docker).
[Unit]
Description=Ciphera - controle periodique du filtrage de sortie

[Timer]
OnCalendar=*:0/5
AccuracySec=10s
Unit=ciphera-egress-check.service

[Install]
WantedBy=timers.target
